<?xml version="1.0" encoding="utf-8"?>
<!--
  Offline state (US-1612, Guideline 4.2).

  Apple rejects a wrapper that shows a blank or error webview with no network.
  This is a NATIVE view, deliberately: a web-rendered offline page cannot be
  shown when the web itself is what failed to load.

  It sits on top of the webview rather than replacing it, so the loaded page
  survives underneath and is still there when connectivity returns.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f4f5f8"
    android:clickable="true"
    android:focusable="true"
    android:fitsSystemWindows="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingLeft="40dp"
        android:paddingRight="40dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Ustyle"
            android:layout_marginBottom="28dp" />

        <TextView
            android:id="@+id/offline_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/offline_title"
            android:textColor="#171717"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/offline_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/offline_body"
            android:textColor="#525252"
            android:textSize="15sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/offline_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/offline_retry"
            android:textColor="#ffffff"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:paddingLeft="32dp"
            android:paddingRight="32dp"
            android:background="@drawable/offline_button"
            android:layout_marginTop="28dp" />
    </LinearLayout>
</FrameLayout>
