<?xml version="1.0" encoding="utf-8"?>
<!--
  Biometric lock (US-1612, Guideline 4.2).

  Opaque and drawn OVER the webview so the client's revenue figures are not
  readable behind it — a translucent scrim would defeat the point of locking.
  Also covers the app in the recents/task-switcher preview.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f4f5f8"
    android:clickable="true"
    android:focusable="true"
    android:fitsSystemWindows="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingLeft="40dp"
        android:paddingRight="40dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Ustyle"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lock_title"
            android:textColor="#171717"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lock_body"
            android:textColor="#525252"
            android:textSize="15sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/lock_unlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lock_unlock"
            android:textColor="#ffffff"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:paddingLeft="32dp"
            android:paddingRight="32dp"
            android:background="@drawable/offline_button"
            android:layout_marginTop="28dp" />
    </LinearLayout>
</FrameLayout>
